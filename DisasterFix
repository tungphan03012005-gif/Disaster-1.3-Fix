-- 2. Logic Cấu hình Anti-AFK
local AntiAFKConfig = {
 Enabled = false,
 Interval = 30,          
 ActionType = "Both"     
}

LocalPlayer.Idled:Connect(function()
 if AntiAFKConfig.Enabled then
  VirtualUser:CaptureController()
  VirtualUser:ClickButton2(Vector2.new(0, 0))
 end
end)

task.spawn(function()
 while true do
  local waitTime = AntiAFKConfig.Interval + math.random(-2, 2)
  task.wait(waitTime)
  
  if AntiAFKConfig.Enabled then
   local character = LocalPlayer.Character
   local humanoid = character and character:FindFirstChildOfClass("Humanoid")
   
   if humanoid and humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
    local action = AntiAFKConfig.ActionType
    
    if action == "Jump" or action == "Both" then
     humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
    
    if action == "Move" or action == "Both" then
     task.delay(0.2, function()
      if humanoid then
       humanoid:Move(Vector3.new(0, 0, -1), true)
       task.wait(0.3)
       humanoid:Move(Vector3.new(0, 0, 0), true)
      end
     end)
    end
   end
  end
 end
end)

-- 3. Logic Khóa vị trí (Position Lock / No Teleport)
local isLockPosEnabled = false
local lastCF, stop, heartbeatConnection

local function startPositionLock()
    if heartbeatConnection then heartbeatConnection:Disconnect() end
    
    heartbeatConnection = RunService.Heartbeat:Connect(function()
        if not isLockPosEnabled or stop then
            return 
        end 
        local char = LocalPlayer.Character
        if char and char:FindFirstChildOfClass('Humanoid') and char:FindFirstChildOfClass('Humanoid').RootPart then
            lastCF = char:FindFirstChildOfClass('Humanoid').RootPart.CFrame
        end
    end)
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass('Humanoid') and char:FindFirstChildOfClass('Humanoid').RootPart then
        char:FindFirstChildOfClass('Humanoid').RootPart:GetPropertyChangedSignal('CFrame'):Connect(function()
            if not isLockPosEnabled then return end
            stop = true
            local c = LocalPlayer.Character
            if c and c:FindFirstChildOfClass('Humanoid') and c:FindFirstChildOfClass('Humanoid').RootPart and lastCF then
                c:FindFirstChildOfClass('Humanoid').RootPart.CFrame = lastCF
            end
            RunService.Heartbeat:Wait()
            stop = false
        end)    
    end
end

LocalPlayer.CharacterAdded:Connect(function(character)
    repeat RunService.Heartbeat:Wait() until character:FindFirstChildOfClass('Humanoid')
    repeat RunService.Heartbeat:Wait() until character:FindFirstChildOfClass('Humanoid').RootPart
    if isLockPosEnabled then
        startPositionLock()
    end
end)

LocalPlayer.CharacterRemoving:Connect(function()
    if heartbeatConnection then
        heartbeatConnection:Disconnect()
    end
end)

-- 4. Logic Cấu hình ESP
local ESPConfig = {
 ShowName = false,
 ShowDistance = false,
 ShowHitbox = false,
 HitboxColor = Color3.fromRGB(255, 0, 0),
 TextColor = Color3.fromRGB(255, 255, 255)
}

local function createESPText(player, character)
 local head = character:WaitForChild("Head", 3)
 if not head then return end
	
 if head:FindFirstChild("ESPTag") then
  head.ESPTag:Destroy()
 end
	
 local billboard = Instance.new("BillboardGui")
 billboard.Name = "ESPTag"
 billboard.Adornee = head
 billboard.Size = UDim2.new(0, 200, 0, 50)
 billboard.StudsOffset = Vector3.new(0, 2.5, 0)
 billboard.AlwaysOnTop = true
	
 local textLabel = Instance.new("TextLabel")
 textLabel.Name = "ESPLabel"
 textLabel.Parent = billboard
 textLabel.Size = UDim2.new(1, 0, 1, 0)
 textLabel.BackgroundTransparency = 1
 textLabel.TextColor3 = ESPConfig.TextColor
 textLabel.TextStrokeTransparency = 0.5
 textLabel.TextSize = 14
 textLabel.Font = Enum.Font.SourceSansBold
 textLabel.Text = ""
	
 billboard.Parent = head
end

local function createESPHitbox(character)
 if character:FindFirstChild("ESPHitbox") then
  character.ESPHitbox:Destroy()
 end
	
 local highlight = Instance.new("Highlight")
 highlight.Name = "ESPHitbox"
 highlight.Adornee = character
 highlight.FillColor = ESPConfig.HitboxColor
 highlight.FillTransparency = 0.5
 highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
 highlight.OutlineTransparency = 0
 highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
 highlight.Parent = character
end

RunService.RenderStepped:Connect(function()
 for _, targetPlayer in ipairs(Players:GetPlayers()) do
  if targetPlayer ~= LocalPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
   local char = targetPlayer.Character
   local hrp = char.HumanoidRootPart
   local head = char:FindFirstChild("Head")
   
   local hitbox = char:FindFirstChild("ESPHitbox")
   if ESPConfig.ShowHitbox then
    if not hitbox then
     createESPHitbox(char)
    end
   elseif hitbox then
    hitbox:Destroy()
   end
   
   if head then
    local espTag = head:FindFirstChild("ESPTag")
    if not espTag then
     createESPText(targetPlayer, char)
     espTag = head:FindFirstChild("ESPTag")
    end
    
    if espTag and espTag:FindFirstChild("ESPLabel") then
     local label = espTag.ESPLabel
     local dist = math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") 
      and (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude) or 0)
     
     local textResult = ""
     if ESPConfig.ShowName then
      textResult = targetPlayer.Name
     end
     
     if ESPConfig.ShowDistance then
      if textResult ~= "" then
       textResult = textResult .. " [" .. dist .. "m]"
      else
       textResult = "[" .. dist .. "m]"
      end
     end
     
     label.Text = textResult
     label.Visible = (ESPConfig.ShowName or ESPConfig.ShowDistance)
    end
   end
  end
 end
end)

